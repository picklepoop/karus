            noclipChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            espChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        elseif input.KeyCode ~= Enum.KeyCode.Unknown then
            local keyName = input.KeyCode.Name
            if changingFor == "Camlock" then
                CamlockSettings.Keybind = input.KeyCode
                camKeyLabel.Text = "Camlock Key: " .. keyName
            elseif changingFor == "Speed" then
                getgenv().walkSpeedSettings.Activation.WalkSpeedToggleKey = keyName
                speedKeyLabel.Text = "Speed Key: " .. keyName
            elseif changingFor == "Fly" then
                FlySettings.Keybind = input.KeyCode
                flyKeyLabel.Text = "Fly Key: " .. keyName
            elseif changingFor == "Strafe" then
                StrafeSettings.Keybind = input.KeyCode
                strafeKeyLabel.Text = "Strafe Key: " .. keyName
            elseif changingFor == "Noclip" then
                NoclipSettings.Keybind = input.KeyCode
                noclipKeyLabel.Text = "Noclip Key: " .. keyName
            elseif changingFor == "ESP" then
                ESPSettings.Keybind = input.KeyCode
                espKeyLabel.Text = "ESP Key: " .. keyName
            end
            changingFor = nil
            camChangeBtn.Text = "Change"
            speedChangeBtn.Text = "Change"
            flyChangeBtn.Text = "Change"
            strafeChangeBtn.Text = "Change"
            noclipChangeBtn.Text = "Change"
            espChangeBtn.Text = "Change"
            camChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            speedChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            flyChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            strafeChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            noclipChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            espChangeBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        end
        return
    end

    -- Camlock toggle
    if input.KeyCode == CamlockSettings.Keybind then
        if CamlockSettings.Locked then
            CamlockSettings.Locked = false
            CamlockSettings.LockedPlayer = nil
            CamlockSettings.LockedTarget = nil
            StrafeSettings.Enabled = false
        else
            local mousePos = UserInputService:GetMouseLocation()
            local closest, minDist = nil, CamlockSettings.FOV

            for _, plr in Players:GetPlayers() do
                if plr == player or not plr.Character then continue end
                local head = plr.Character:FindFirstChild("Head")
                if not head then continue end

                local screen, onScreen = camera:WorldToViewportPoint(head.Position)
                if not onScreen then continue end

                local dist = (Vector2.new(screen.X, screen.Y) - mousePos).Magnitude
                if dist < minDist then
