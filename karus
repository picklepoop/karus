--  Noclip (fully fixed)
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

local NoclipSettings = {
    Enabled = false,
    Keybind = Enum.KeyCode.N,
}

local noclipConn

local function updateNoclip()
    if NoclipSettings.Enabled then
        if noclipConn then noclipConn:Disconnect() end
        noclipConn = RunService.Stepped:Connect(function()
            if player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    end
end

RunService.Heartbeat:Connect(updateNoclip)

-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
--  ESP (simple name + box through walls)
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

local ESPSettings = {
    Enabled = false,
    Keybind = Enum.KeyCode.E,
}

local espConnections = {}
local espDrawings = {}

local function addESP(plr)
    if plr == player or espDrawings[plr] then return end

    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Filled = false
    box.Transparency = 1
    box.Color = Color3.fromRGB(255, 50, 50)

    local name = Drawing.new("Text")
    name.Size = 14
    name.Center = true
    name.Outline = true
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Text = plr.Name

    espDrawings[plr] = {Box = box, Name = name}

    local conn
    conn = RunService.RenderStepped:Connect(function()
        if not ESPSettings.Enabled or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
            box.Visible = false
            name.Visible = false
            return
        end

        local root = plr.Character.HumanoidRootPart
        local head = plr.Character:FindFirstChild("Head")
        if not head then return end

        local rootPos, onScreen = camera:WorldToViewportPoint(root.Position)
        local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
        local legPos = camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))

        if onScreen then
            local height = math.abs(headPos.Y - legPos.Y)
            local width = height * 0.5

            box.Size = Vector2.new(width, height)
            box.Position = Vector2.new(rootPos.X - width/2, rootPos.Y - height/2)
            box.Visible = true

            name.Position = Vector2.new(rootPos.X, rootPos.Y - height/2 - 16)
            name.Visible = true
        else
            box.Visible = false
            name.Visible = false
        end
    end)

    espConnections[plr] = conn

    plr.CharacterRemoving:Connect(function()
        if espDrawings[plr] then
            espDrawings[plr].Box:Remove()
            espDrawings[plr].Name:Remove()
            espDrawings[plr] = nil
        end
        if espConnections[plr] then
            espConnections[plr]:Disconnect()
            espConnections[plr] = nil
        end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player then addESP(plr) end
end

Players.PlayerAdded:Connect(addESP)

