--  Sticky Camlock + 3D Strafe Logic (with respawn re-lock)
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

RunService.RenderStepped:Connect(function(dt)
    -- Auto-unlock if player leaves
    if CamlockSettings.Locked then
        if not CamlockSettings.LockedPlayer or not CamlockSettings.LockedPlayer.Parent then
            CamlockSettings.Locked = false
            CamlockSettings.LockedPlayer = nil
            CamlockSettings.LockedTarget = nil
            StrafeSettings.Enabled = false
        elseif not CamlockSettings.LockedTarget or not CamlockSettings.LockedTarget.Parent then
            CamlockSettings.LockedTarget = nil
        end
    end

    -- Re-target on respawn
    if CamlockSettings.Locked and CamlockSettings.LockedPlayer and not CamlockSettings.LockedTarget then
        local char = CamlockSettings.LockedPlayer.Character
        if char then
            local newHead = char:FindFirstChild("Head")
            if newHead then
                CamlockSettings.LockedTarget = newHead
            end
        end
    end

    -- Camlock aim
    if CamlockSettings.Locked and CamlockSettings.LockedTarget and CamlockSettings.LockedTarget.Parent then
        local targetPos = CamlockSettings.LockedTarget.Position
        local cf = camera.CFrame
        local goal = CFrame.new(cf.Position, targetPos)
        camera.CFrame = cf:Lerp(goal, CamlockSettings.Strength)
    end

    -- 3D Strafe
    if StrafeSettings.Enabled and CamlockSettings.Locked and CamlockSettings.LockedTarget then
        strafeHAngle = strafeHAngle + StrafeSettings.HSpeed * dt
        strafeVAngle = strafeVAngle + StrafeSettings.VSpeed * dt

        local targetPos = CamlockSettings.LockedTarget.Position
        local offset = Vector3.new(
            math.cos(strafeHAngle) * StrafeSettings.Radius,
            math.sin(strafeVAngle) * (StrafeSettings.Radius * 0.6) + 2,
            math.sin(strafeHAngle) * StrafeSettings.Radius
        )

        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.CFrame = CFrame.new(targetPos + offset, targetPos)
        end
    end

    updateStatus()
end)

