-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

local function setupSlider(bg, fill, knob, label, setter, maxVal)
    local draggingS = false

    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingS = true
        end
    end)

    bg.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingS = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not draggingS then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local pct = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)

        fill.Size     = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -8, 0.5, -8)

        setter(pct)
        if maxVal then
            if label.Text:match("Lock FOV") then
                label.Text = ("Lock FOV: %d px"):format(math.floor(pct * maxVal))
            elseif label.Text:match("Fly Speed") then
                label.Text = ("Fly Speed: %d"):format(math.floor(pct * maxVal))
            elseif label.Text:match("Strafe Radius") then
                label.Text = ("Strafe Radius: %d"):format(math.floor(pct * maxVal))
            elseif label.Text:match("Spin Speed") then
                label.Text = ("Spin Speed: %d"):format(math.floor(pct * maxVal))
            end
        else
            label.Text = ("Camlock Strength: %.0f%%"):format(pct * 100)
        end
    end)
end

